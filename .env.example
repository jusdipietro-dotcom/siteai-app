# AutomaticIAlab — Required Environment Variables

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DIRECT_URL="postgresql://user:pass@host:5432/dbname"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://automaticialab.com"
NEXT_PUBLIC_APP_URL="https://automaticialab.com"

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# MercadoPago
MP_ACCESS_TOKEN="APP_USR-..."
# REQUIRED: Webhook HMAC secret from MP Developer Dashboard
# Without this, ALL webhook requests are REJECTED
MP_WEBHOOK_SECRET="get-from-mp-developer-dashboard-webhook-config"

# Credential Encryption (AES-256-GCM)
# MUST be at least 32 characters. Generate with: openssl rand -hex 16
CREDENTIALS_ENCRYPTION_KEY="generate-32-char-random-string-here"

# n8n Integration
SCRAPER_API_KEY="your-scraper-api-key"
N8N_PROVISIONING_WEBHOOK="https://your-n8n-instance/webhook/monitoring-provision"

# Admin
ADMIN_EMAILS="admin@example.com"
