generator client {
  provider = "prisma-client-js"
  // The runtime image is Alpine (musl) with OpenSSL 3, so the musl engine is
  // required. The standalone build only traces the engines Prisma generated,
  // so a missing target fails at request time, not at build time.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  password       String?
  image          String?
  plan           String   @default("free")
  isFreeAccount  Boolean  @default(false)
  freeAccountNote String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // ── Account deletion lifecycle (see lib/account-deletion.ts) ───────────────
  // Three columns rather than one status string, because each answers a
  // different question and each is written at a different moment:
  //
  //   deletionRequestedAt  — when the owner asked. Non-null BLOCKS all access
  //                          immediately (the session callback in lib/auth.ts
  //                          refuses to hydrate a session for such a user), so
  //                          the account is unusable from that instant.
  //   deletionScheduledFor — the earliest instant the purge may run:
  //                          requestedAt + 30 days, the window promised in
  //                          app/privacy/page.tsx. STORED rather than derived
  //                          so that changing DELETION_WINDOW_MS later cannot
  //                          retroactively move an in-flight deadline.
  //   deletedAt            — when the purge actually ran. Non-null means this
  //                          row is a billing TOMBSTONE: the personal data is
  //                          gone, but the row survives because the anonymised
  //                          financial trail (Project / *Subscription rows)
  //                          hangs off this id by foreign key. Hard-deleting
  //                          the User would cascade that trail away, which is
  //                          the opposite compliance problem.
  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?
  deletedAt            DateTime?

  projects                    Project[]
  media                       Media[]
  monitoringSubscriptions     MonitoringSubscription[]
  reviewsSubscriptions        ReviewsSubscription[]
  linkedinSubscriptions       LinkedInSubscription[]
  tradingSubscriptions        TradingSubscription[]
  leadsSubscriptions          LeadsSubscription[]
  emailMarketingSubscriptions EmailMarketingSubscription[]
  prospeccionSubscriptions    ProspeccionSubscription[]
  facturacionSubscriptions    FacturacionSubscription[]
  causasSubscriptions         CausasSubscription[]
  turnosSubscriptions         TurnosSubscription[]
  suiteJuridicaSubscriptions  SuiteJuridicaSubscription[]
  lexpostSubscriptions        LexPostSubscription[]
  passwordResetTokens         PasswordResetToken[]

  // The daily purge sweep (POST /api/admin/expire-trials) scans exactly this:
  // "scheduled on or before now, not purged yet".
  @@index([deletionScheduledFor, deletedAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id           String   @id @default(cuid())
  userId       String
  name         String
  url          String
  thumbnailUrl String?
  type         String   @default("image")
  category     String   @default("misc")
  size         Int
  width        Int?
  height       Int?
  alt          String?
  favorite     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonitoringSubscription {
  id                String    @id @default(cuid())
  userId            String
  status            String    @default("pending_payment") // pending_payment, active, provisioning, suspended, cancelled
  plan              String // basico, profesional, estudio
  portal            String // PJN, SCBA, AMBOS
  cuil              String
  credentialUser    String // encrypted portal username
  credentialPass    String // encrypted portal password
  credentialIv      String // AES-GCM IV (hex)
  credentialTag     String // AES-GCM auth tag (hex)
  notificationEmail String // email donde se envían las alertas judiciales
  payerEmail        String // email de facturación (puede ser distinto)
  preapprovalId     String?
  couponId          String?
  discountApplied   Int       @default(0) // percentage discount applied
  trialEndsAt       DateTime?
  provisionedAt     DateTime?
  n8nTenantId       String? // tenant ID in n8n workflows once provisioned
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([userId, cuil])
  @@index([preapprovalId])
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  discount   Int // percentage 1-100
  maxUses    Int      @default(1)
  usedCount  Int      @default(0)
  validFrom  DateTime @default(now())
  validUntil DateTime
  createdBy  String // admin user ID
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  subscriptions               MonitoringSubscription[]
  reviewsSubscriptions        ReviewsSubscription[]
  linkedinSubscriptions       LinkedInSubscription[]
  tradingSubscriptions        TradingSubscription[]
  leadsSubscriptions          LeadsSubscription[]
  emailMarketingSubscriptions EmailMarketingSubscription[]
  prospeccionSubscriptions    ProspeccionSubscription[]
  facturacionSubscriptions    FacturacionSubscription[]
  causasSubscriptions         CausasSubscription[]
  turnosSubscriptions         TurnosSubscription[]
  suiteJuridicaSubscriptions  SuiteJuridicaSubscription[]
  lexpostSubscriptions        LexPostSubscription[]
  // Website generator. Unlike the 12 subscription products above, a redemption
  // here never opens a MercadoPago preapproval — a 100% coupon marks the
  // project paid directly (app/api/projects/[id]/redeem-coupon).
  projects                    Project[]
}

model TradingSubscription {
  id                String    @id @default(cuid())
  userId            String
  status            String    @default("pending_payment") // pending_payment, trial, active, provisioning, suspended, cancelled
  plan              String // basico, profesional, premium
  symbols           String    @default("BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT") // pares monitoreados
  timeframe         String    @default("1h") // 1h, 4h, 15m
  telegramChatId    String? // chatId de Telegram del usuario
  notificationEmail String
  payerEmail        String
  signalsSent       Int       @default(0)
  preapprovalId     String?
  couponId          String?
  discountApplied   Int       @default(0)
  trialEndsAt       DateTime?
  provisionedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([userId, status])
}

