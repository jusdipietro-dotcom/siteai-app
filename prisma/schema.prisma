generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String?
  image     String?
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects              Project[]
  media                 Media[]
  monitoringSubscriptions MonitoringSubscription[]
}

model Media {
  id           String   @id @default(cuid())
  userId       String
  name         String
  url          String
  thumbnailUrl String?
  type         String   @default("image")
  category     String   @default("misc")
  size         Int
  width        Int?
  height       Int?
  alt          String?
  favorite     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonitoringSubscription {
  id              String   @id @default(cuid())
  userId          String
  status          String   @default("pending_payment") // pending_payment, active, provisioning, suspended, cancelled
  plan            String   // basico, profesional, estudio
  portal          String   // PJN, SCBA, AMBOS
  cuil            String
  credentialUser  String   // encrypted portal username
  credentialPass  String   // encrypted portal password
  credentialIv    String   // AES-GCM IV (hex)
  credentialTag   String   // AES-GCM auth tag (hex)
  notificationEmail String // email donde se envían las alertas judiciales
  payerEmail      String   // email de facturación (puede ser distinto)
  preapprovalId   String?
  couponId        String?
  discountApplied Int      @default(0) // percentage discount applied
  provisionedAt   DateTime?
  n8nTenantId     String?  // tenant ID in n8n workflows once provisioned
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id])
}

model Coupon {
  id            String   @id @default(cuid())
  code          String   @unique
  discount      Int      // percentage 1-100
  maxUses       Int      @default(1)
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime
  createdBy     String   // admin user ID
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  subscriptions MonitoringSubscription[]
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  name          String
  slug          String
  status        String   @default("draft")
  plan          String   @default("free")
  hasPaid       Boolean  @default(false)
  preapprovalId String?
  template      String?
  thumbnail     String?
  publishedUrl  String?
  views         Int      @default(0)
  businessData  String
  sections      String
  mediaIds      String   @default("[]")
  coverImageId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
