  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([preapprovalId])
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  name          String
  slug          String
  // Custom subdomain for {subdomain}.sitios.automaticialab.com.
  // Always stored lowercase (see lib/subdomain.ts): the unique index is
  // case-sensitive, so normalization is what stops "Foo" and "foo" coexisting.
  // Nullable and plan-agnostic on purpose — free projects keep the path URL.
  subdomain     String?  @unique
  // Custom domain (Professional): the client's own domain, e.g. "tunegocio.com.ar".
  // Lowercase and unique. Routing + TLS are provisioned in Traefik out of band
  // (the app never holds panel credentials — see the domain flow), and the
  // status column tracks that lifecycle:
  //   'none'     — not configured
  //   'pending'  — entered, DNS not yet pointing at us
  //   'verified' — DNS resolves to our IP, ready to activate in Traefik
  //   'active'   — activated (certificate issued), serving over the domain
  customDomain            String?   @unique
  customDomainStatus      String    @default("none")
  customDomainVerifiedAt  DateTime?
  // Per-project ownership challenge. The A record only proves the domain points
  // at our SHARED host — not that the requester controls the domain. This random
  // token must be published as a TXT record at _automaticialab-verify.{domain},
  // which only the real DNS owner can do. Verify requires it in addition to the A
  // record, so a paid user cannot squat a domain they don't actually own.
  customDomainVerifyToken String?
  status        String   @default("draft")
  plan          String   @default("free")
  hasPaid       Boolean  @default(false)
  preapprovalId String?
  // Billing lifecycle, deliberately separate from `status` (draft/published)
  // and `hasPaid` (ever completed a payment). Keeping the three independent is
  // what lets the dashboard tell "you never paid" from "you unpublished this"
  // from "we suspended you for non-payment" — collapsing suspension into
  // hasPaid=false would make a suspended site look like it never paid.
  // One of: 'active' | 'grace' | 'suspended'.
  billingStatus   String    @default("active")
  // Deadline for recovering a failed recurring charge. While this is in the
  // future the site stays live; once it passes the site is treated as
  // suspended at read time, whether or not any job has run.
  graceUntil      DateTime?
  suspendedAt     DateTime?
  // 'payment_failed' (grace elapsed) | 'cancelled' (deliberate user action).
  suspendedReason String?
  // Gift provenance. `hasPaid` alone cannot distinguish a site an admin
  // comped from one a customer actually paid for, which is exactly the
  // ambiguity the old regalar-sitio.sh left behind. Deliberately separate
  // columns rather than a flag folded into `plan` or `billingStatus`, so a
  // gift stays traceable even after the plan changes.
  // Stores the granting admin's email (readable, and survives that admin's
  // User row being deleted). Both null => not a gift.
  grantedBy       String?
  grantedAt       DateTime?
  // Coupon provenance, deliberately separate from the gift columns above.
  // Three ways a project can end up with hasPaid = true, and the owner has to
  // be able to tell them apart months later:
  //   grantedBy/grantedAt set  => an admin comped it;
  //   couponId set             => the owner redeemed a 100% coupon;
  //   neither                  => a real MercadoPago sale (preapprovalId set).
  // Overloading grantedBy with a sentinel like 'coupon:XXX' would make every
  // "who comped this?" query lie, so these are their own columns.
  //
  // Only 100%-discount coupons are accepted here (see the redeem route): a
  // partial discount would have to change the MercadoPago subscription amount,
  // which this product does not do.
  //
  // These stay set if a gift is later revoked. Unlike grantedBy — which means
  // "currently comped" — a redemption is a historical fact: the use was already
  // consumed from the coupon and is not refunded, so erasing the trace would
  // hide it.
  couponId         String?
  couponRedeemedAt DateTime?
  template      String?
  thumbnail     String?
  publishedUrl  String?
  views         Int      @default(0)
  businessData  String
  sections      String
  mediaIds      String   @default("[]")
  coverImageId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteLeads SiteLead[]
  coupon    Coupon?    @relation(fields: [couponId], references: [id])

  @@index([billingStatus, graceUntil])
  // Every `payment` notification runs findFirst({ where: { preapprovalId } })
  // against this table, for all 13 products — so without this index every
  // payment event anyone makes seq-scans Project. Every other subscription
  // model already carries the same index.
  @@index([preapprovalId])
  // The owner lookup behind every project route ("list my projects", and the
  // ownership check on each mutation).
  @@index([userId])
  // Public page views resolve the site by slug (lib/published-site.ts), so this
  // is on the read path of every visit to a published site.
  @@index([slug])
}

model LexPostSubscription {
  id                String    @id @default(cuid())
  userId            String
  status            String    @default("pending_payment")
  plan              String // basico, profesional, estudio
  igUsername         String?
  igAccountCount    Int       @default(1)
  publicationsUsed  Int       @default(0)
  publicationsLimit Int       @default(10)
  lexpostTenantId   String?
  lexpostUserEmail  String?
  notificationEmail String
  payerEmail        String
  preapprovalId     String?
  couponId          String?
  discountApplied   Int       @default(0)
  trialEndsAt       DateTime?
  provisionedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id])

  @@index([userId, status])
  @@index([preapprovalId])
}

model Inquiry {
  id          String   @id @default(cuid())
  service     String   // diseno-web, seo, custom, premium
  packageId   String?  // id del paquete elegido (landing-basic, seo-pro, etc)
  name        String
  email       String
  phone       String?
  company     String?
  website     String?
  budget      String?  // rango de presupuesto orientativo
  message     String   @db.Text
  source      String?  // pagina de origen
  status      String   @default("new") // new, contacted, won, lost
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([service, status])
  @@index([createdAt])
}

// Leads captured by the contact form on a published client site. Distinct from
// Inquiry (which is the agency's own sales funnel): a SiteLead belongs to a
// specific Project, so it is routed to and owned by that project's user — never
// the platform. Kept separate rather than folded into Inquiry so the two flows,
// which have different recipients and lifecycles, never bleed into each other.
model SiteLead {
  id        String   @id @default(cuid())
  projectId String
  name      String
  email     String
  phone     String?
  message   String   @db.Text
  status    String   @default("new") // new, read, archived
  ipAddress String?
  userAgent String?  @db.Text
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // The owner reads their leads newest-first, scoped to a project they own.
  @@index([projectId, createdAt])
}
